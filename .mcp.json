{
  "mcpServers": {
    
    "mysql": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@benborla29/mcp-server-mysql@2.0.2"
      ],
      "env": {
        "MYSQL_HOST": "192.168.50.177",
        "MYSQL_PORT": "53306",
        "MYSQL_USER": "herbal_user",
        "MYSQL_PASS": "herbal_password",
        "MYSQL_DB": "herbal_erp",
        "ALLOW_INSERT_OPERATION": "true",
        "ALLOW_UPDATE_OPERATION": "true",
        "ALLOW_DELETE_OPERATION": "true",
        "ALLOW_DDL_OPERATION": "true",
        "MYSQL_DISABLE_READ_ONLY_TRANSACTIONS": "true"
      }
    },

    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    }
  }
}
