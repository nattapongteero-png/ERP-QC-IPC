<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- DevExpress NuGet Feed - Replace YOUR_FEED_URL with your licensed DevExpress NuGet feed URL -->
    <!-- To get your feed URL, visit: https://nuget.devexpress.com/ -->
    <add key="DevExpress" value="https://nuget.devexpress.com/YOUR_FEED_URL/api" />
  </packageSources>
  <packageSourceCredentials>
    <!-- Uncomment and configure if your DevExpress feed requires authentication -->
    <!--
    <DevExpress>
      <add key="Username" value="YOUR_USERNAME" />
      <add key="ClearTextPassword" value="YOUR_PASSWORD" />
    </DevExpress>
    -->
  </packageSourceCredentials>
</configuration>
