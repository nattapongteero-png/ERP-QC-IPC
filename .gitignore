# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Playwright run artifacts (videos, failure screenshots, error-context)
/test-results/
# SQLite test database (regenerated on each test run)
test.db

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local-only build logs and machine-specific compose override (not for VCS)
uat-build*.log
uat-rebuild*.log
docker-compose.override.yml

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# database
/mysql_data/
/data/

# typescript
*.tsbuildinfo
next-env.d.ts
reference/AspNetCore.Reporting.BestPractices

# Git worktrees
.worktrees/

# Playwright MCP test artifacts (debug logs, screenshots, snapshots)
.playwright-mcp/

# Superpowers / agent state
.superpowers/

# Ad-hoc debug/test screenshots at repo root
/*.png

# Runtime user data
/uploads/
/exports/

# Daily summaries & one-off reports (training/log artifacts — not source)
docs/daily-summary-*.md
docs/*-Test-Report.xlsx
docs/*-Report.xlsx
public/dev-summary-*.html
public/system-completeness-*.html

# Training docs / agent planning artifacts
docs/training/
docs/superpowers/
public/his-vmi-sales-flow.html

# Docker UAT mysql volume
uat_mysql_data/
herbal-app-uat.tar.gz
