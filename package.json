{
  "name": "herbal-medicine-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "tsx scripts/validate-i18n.ts || echo '[i18n] Warning: Missing translations detected. Build continues...'",
    "build": "next build --webpack",
    "build:theme": "devextreme build-theme --input-file=devextreme-theme/emerald-metadata.json --output-file=public/css/dx.material.emerald.css",
    "start": "next start",
    "lint": "eslint",
    "test": "DB_TYPE=sqlite vitest",
    "test:run": "DB_TYPE=sqlite vitest run",
    "test:coverage": "DB_TYPE=sqlite vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "DB_TYPE=sqlite tsx src/lib/db/seed.ts",
    "i18n:check": "tsx scripts/validate-i18n.ts",
    "i18n:check:verbose": "tsx scripts/validate-i18n.ts --verbose",
    "i18n:fix": "tsx scripts/validate-i18n.ts --fix"
  },
  "dependencies": {
    "@devexpress/analytics-core": "25.2.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sparticuz/chromium": "^148.0.0",
    "@tanstack/react-query": "^5.90.12",
    "ace-builds": "^1.43.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "devexpress-reporting": "25.2.3",
    "devexpress-reporting-react": "25.2.3",
    "devextreme": "25.2.3",
    "devextreme-react": "25.2.3",
    "drizzle-orm": "^0.45.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "js-cookie": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.561.0",
    "mammoth": "^1.11.0",
    "mysql2": "^3.16.0",
    "next": "16.0.10",
    "next-auth": "^4.24.13",
    "next-intl": "^4.7.0",
    "puppeteer-core": "^24.42.0",
    "qrcode": "^1.5.4",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "recharts": "^3.6.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/file-saver": "^2.0.7",
    "@types/js-cookie": "^3.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "devextreme-themebuilder": "25.2.3",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "jsdom": "^27.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.16",
    "vitest-canvas-mock": "^1.1.3"
  }
}
