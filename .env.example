# Local development database configuration
DB_TYPE=mysql
DATABASE_URL=mysql://herbal_user:herbal_password@127.0.0.1:53306/herbal_erp
JWT_SECRET=your-secret-key-change-in-production

# DevExpress Reporting Backend URL
# For local development (when running Next.js outside Docker)
# The frontend uses /api/reporting proxy, so this is only needed for server-side calls
REPORTING_BACKEND_URL=http://localhost:5000

# Legacy: Not needed anymore - frontend uses /api/reporting proxy
# NEXT_PUBLIC_REPORTING_BACKEND_URL=http://localhost:5000

# VMI Portal Configuration
# Base URL for VMI Portal API (vendor integration)
VMI_PORTAL_BASE_URL=https://vmi-portal.bmscloud.in.th/api/external/vendor

# Encryption key for storing API keys at rest (32-byte hex key)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VMI_ENCRYPTION_KEY=

# Secret for authenticating cron job requests
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
