# Factory identity printed on formal GMP documents (QC reports, COAs).
# LICENSE_NO and ADDRESS are intentionally blank by default: an unset value is
# omitted from the printout, whereas a placeholder ("GMP-XXXX/XXXX") on a
# document handed to a regulator or customer is a compliance problem.
# Fill these in with the real values from QA before issuing printed documents.
NEXT_PUBLIC_FACTORY_NAME_TH=โรงงานผลิตยาสมุนไพร
NEXT_PUBLIC_FACTORY_NAME_EN=Herbal Medicine Manufacturing
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_FACTORY_LICENSE_NO=

# Local development database configuration
DB_TYPE=mysql
DATABASE_URL=mysql://herbal_user:herbal_password@127.0.0.1:53306/herbal_erp
JWT_SECRET=your-secret-key-change-in-production

# DevExpress Reporting Backend URL
# For local development (when running Next.js outside Docker)
# The frontend uses /api/reporting proxy, so this is only needed for server-side calls
REPORTING_BACKEND_URL=http://localhost:5000

# Legacy: Not needed anymore - frontend uses /api/reporting proxy
# NEXT_PUBLIC_REPORTING_BACKEND_URL=http://localhost:5000

# VMI Portal Configuration
# Base URL for VMI Portal API (vendor integration)
VMI_PORTAL_BASE_URL=https://vmi-portal.bmscloud.in.th/api/external/vendor

# Encryption key for storing API keys at rest (32-byte hex key)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VMI_ENCRYPTION_KEY=

# Secret for authenticating cron job requests
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# HR Module: Employee Data Encryption
# 32-character key for AES-256-GCM encryption of sensitive employee data
# (Thai CID, bank account numbers, etc.)
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
EMPLOYEE_DATA_ENCRYPTION_KEY=

# ============================================
# BMS AI Ecosystem (self-hosted)
# ============================================
# Each client degrades gracefully if its BASE_URL is empty (feature simply
# disabled). API keys are optional and only needed if the gateway enforces auth.

# LLM brain - vllm-gemma (Gemma-4-31B, OpenAI-compatible)
AI_LLM_BASE_URL=https://vllm-gemma.bmscloud.in.th
AI_LLM_API_KEY=
AI_LLM_MODEL=default

# Speech-to-text - asr2 (Whisper-style)
AI_ASR_BASE_URL=https://asr2.bmscloud.in.th
AI_ASR_API_KEY=
AI_ASR_MODEL=default

# Text-to-speech - vox-cpm (Thai)
AI_TTS_BASE_URL=https://vox-cpm.bmscloud.in.th
AI_TTS_API_KEY=
AI_TTS_MODEL=voxcpm-thai
AI_TTS_VOICE=default

# Document OCR - pdf-ocr-mcp (Typhoon/Chandra/Gemma-4)
AI_OCR_BASE_URL=https://pdf-ocr-mcp.bmscloud.in.th
AI_OCR_API_KEY=
